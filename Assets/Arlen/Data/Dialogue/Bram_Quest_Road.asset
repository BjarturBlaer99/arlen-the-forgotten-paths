  m_Script: {fileID: 11500000, guid: df58795d0a3134c5da043aa1a759d47b, type: 3}
  m_Name: Bram_Quest_Road
  m_EditorClassIdentifier: Arlen::Arlen.DialogueSystem.DialogueData
  defaultSpeaker: Bram
  lines:
  - speaker: You
    text: Bram, you've hauled ore down the Mosswood Road a hundred times. When did it close?
  - speaker: 
    text: Road? Kid, the only road north of the stream is the one my boots make.
  - speaker: 
    text: ...Though Eldon came by three days back, wanting a lantern and a good knife. Said he was "following a line that shouldn't be there".
  - speaker: 
    text: Didn't make sense then either. If you're going after him, there's a boar ruffian camped in the clearing. Watch its shoulders.
