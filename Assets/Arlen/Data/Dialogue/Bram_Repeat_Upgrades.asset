  m_Script: {fileID: 11500000, guid: df58795d0a3134c5da043aa1a759d47b, type: 3}
  m_Name: Bram_Repeat_Upgrades
  m_EditorClassIdentifier: Arlen::Arlen.DialogueSystem.DialogueData
  defaultSpeaker: Bram
  lines:
  - speaker: 
    text: Upgrades? Bring me good ore and honest coin and we'll talk.
  - speaker: 
    text: 'Until then, keep your guard up. Watch their shoulders: a ruffian always rears back before he swings.'
